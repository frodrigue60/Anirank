# ==============================================================================
# ANIRANK CENTRALIZED ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to version control.

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (PUBLIC)
# ------------------------------------------------------------------------------
# In SvelteKit, variables prefixed with PUBLIC_ are exposed to the client.
# APP_URL is used for sitemap generation and social share links.
APP_URL=
PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (PRIVATE)
# ------------------------------------------------------------------------------

# --- Server ---
APP_PORT=8080
APP_ENV=development
API_URL=
ALLOW_ORIGINS=
CACHE_ENABLED=false

# --- Database ---
# Use 'db' if running via Docker Compose, 'localhost' if running binary directly
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT_EXTERNAL=5432

# --- Security ---
JWT_SECRET=
JWT_EXPIRATION_HOURS=72
ENCRYPTION_KEY=

# --- Cache (Redis) ---
# Use 'redis://redis:6379' for Docker, 'localhost:6379' for local
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379

# --- Storage (S3 / R2) ---
STORAGE_TYPE=s3
# S3 / MinIO Configuration
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_USE_SSL=false

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- OAuth2 Configuration ---
# AniList
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URL=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GOOGLE_LOGIN_REDIRECT_URL=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=
DISCORD_LOGIN_REDIRECT_URL=

# --- Infrastructure ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=

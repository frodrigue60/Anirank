# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to version control.

# --- APPLICATION ---
APP_PORT=
APP_ENV=
APP_URL=
PUBLIC_API_URL=
API_URL=
ALLOW_ORIGINS=
CACHE_ENABLED=

# --- DATABASE ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT_EXTERNAL=

# --- SECURITY ---
JWT_SECRET=
JWT_EXPIRATION_HOURS=
ENCRYPTION_KEY=

# --- CACHE (REDIS) ---
REDIS_URL=

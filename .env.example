# --- ADMIN CONFIG (FIRST RUN) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- ANILIST OAUTH2 ---
ANILIST_API_URL=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

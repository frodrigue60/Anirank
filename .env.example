# --- STORAGE (S3 / MINIO) ---
STORAGE_TYPE=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

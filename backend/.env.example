# Application
APP_PORT=8080
CACHE_ENABLED=false
APP_ENV=development
ALLOW_ORIGINS=http://localhost:5173, http://localhost:8080
ENCRYPTION_KEY=your-32-character-encryption-key-here
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anirank
DB_PORT_EXTERNAL=5432

# Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION_HOURS=72

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage (S3 / MinIO)
STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=anirank
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_PUBLIC_URL=http://localhost:9000/anirank
S3_USE_SSL=false

# Legacy MinIO keys
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anirank

# Frontend Helper
PUBLIC_API_URL=http://localhost:8080/api

# Default Admin (First Run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=yourpasswordhere

# AniList OAuth2
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URL=http://localhost:5173/settings/account

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/settings/account
GOOGLE_LOGIN_REDIRECT_URL=http://localhost:5173/login

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:5173/settings/account
DISCORD_LOGIN_REDIRECT_URL=http://localhost:5173/login

# Cloudflare Tunnel (Optional)
CLOUDFLARE_TUNNEL_TOKEN=

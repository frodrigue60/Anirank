FROM golang:1.26-alpine

WORKDIR /app

# Install system dependencies needed for the backend (vips, gcc for CGO, etc.)
RUN apk add --no-cache git vips-dev gcc musl-dev ca-certificates vips vips-tools libavif-apps libwebp-tools

# We don't COPY here because we use volumes in docker-compose.dev.yml
# But we need a placeholder to keep the container alive if needed
CMD ["go", "run", "cmd/api/main.go"]
